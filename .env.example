# PostgreSQL Neon (use a pooled connection string in Vercel)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long, random bearer token used only by the Windows synchronization agent
SYNC_API_TOKEN=replace-with-at-least-32-random-characters

# Optional explicit public URL (useful for scripts and previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000
