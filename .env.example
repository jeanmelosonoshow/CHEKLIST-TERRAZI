# PostgreSQL Neon (use a pooled connection string in Vercel)
DATABASE_URL=password@host/database?sslmode=require

# Firebird Gateway (server-side only; never prefix these with NEXT_PUBLIC_)
FIREBIRD_GATEWAY_URL=https://gateway.jgmelo.company
FIREBIRD_GATEWAY_TOKEN_ID=ssg_replace_with_token_id
FIREBIRD_GATEWAY_HMAC_SECRET=replace-with-hmac-secret

# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long, random bearer token used only by the Windows synchronization agent
SYNC_API_TOKEN=replace-with-at-least-32-random-characters

# Optional explicit public URL (useful for scripts and previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000
